    "frequency_guidelines": {
      "pulse_channels": {
        "optimal_range_hz": [200, 2000],
        "acceptable_range_hz": [80, 4000],
        "notes": "Square waves with variable duty cycle, best for melodies and harmonies"
      },
      "triangle_channel": {
        "optimal_range_hz": [80, 400],
        "acceptable_range_hz": [27, 2000],
        "notes": "Fixed volume triangle wave, excellent for bass lines"
      },
      "noise_channel": {
        "optimal_range_hz": [100, 5000],
        "acceptable_range_hz": [50, 20000],
        "notes": "Pseudo-random noise, ideal for percussion and special effects"
      },
      "dmc_channel": {
        "optimal_range_hz": [60, 1000],
        "acceptable_range_hz": [50, 8000],
        "notes": "Sample-based channel, good for bass enhancement and special sounds"
      }
